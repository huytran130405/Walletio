{
  "expo": {
    "name": "Walletio",
    "slug": "walletio",
    "version": "1.0.0",
    "orientation": "portrait",
    "primaryColor": "#1A9E6E",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1A9E6E"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A9E6E"
      },
      "package": "com.zhugeb1ao.walletio"
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-asset"
    ]
  }
}
